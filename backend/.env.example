# ==============================================================================
# Bistirno ArchStudio Pro - Backend Environment Variables
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-random-key-1234567890
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Config (Default: SQLite for local development)
# For PostgreSQL in staging/production:
# DATABASE_URL=postgres://user:password@localhost:5432/archstudio_db
DATABASE_URL=sqlite:///db.sqlite3

# CORS & CSRF Origins (Allow local frontend running via Live Server or similar)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=True

# JWT Configuration (in minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Media & Static storage
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

